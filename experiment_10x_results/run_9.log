import sys

def solve():
    # Read input
    line = sys.stdin.readline().strip()
    if not line:
        return
    
    n, w = map(int, line.split())
    
    # Read initial block positions
    blocks = []
    for _ in range(n):
        x, y = map(int, sys.stdin.readline().split())
        blocks.append((x, y))
    
    # Read queries
    q = int(sys.stdin.readline().strip())
    
    # Group blocks by column
    column_blocks = {}
    for x, y in blocks:
        if x not in column_blocks:
            column_blocks[x] = []
        column_blocks[x].append(y)
    
    # Process queries
    for _ in range(q):
        a, t = map(int, sys.stdin.readline().split())
        
        # Check if there's a block in column a with row >= t
        if a in column_blocks:
            # The block exists at time t+0.5 if there's a block that can fall to row t or below
            # Since blocks only fall down, they can only reach row r if their initial row >= r
            # So we need at least one block with initial row >= t
            if any(y >= t for y in column_blocks[a]):
